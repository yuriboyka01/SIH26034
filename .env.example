# Database
DATABASE_URL=postgresql://sih26034:sih26034_password@localhost:5432/sih26034

# JWT Authentication
JWT_SECRET=change-this-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File Upload (Local Default)
UPLOAD_DIR=../data/uploads
MAX_UPLOAD_SIZE=10485760

# Storage Backend: "local" (default) or "s3"
# Render filesystem is ephemeral; set to "s3" in production to persist files across redeploys.
STORAGE_BACKEND=local

# S3-compatible Object Storage (Required if STORAGE_BACKEND=s3)
# Works with AWS S3, Cloudflare R2, Backblaze B2, MinIO, etc.
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
# S3_ENDPOINT_URL is optional; set for Cloudflare R2, Backblaze B2, or MinIO. Leave blank for AWS S3.
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Extraction (Groq) — Optional
# If not provided, the system falls back to regex-based extraction.
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Note: GEMINI_API_KEY is not used in this project
